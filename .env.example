# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token
# ID администраторов в Telegram через запятую (доступ к /admin в боте)
ADMIN_IDS=123456789

# База данных. SQLite по умолчанию, для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/anonchat
DATABASE_URL=sqlite+aiosqlite:///data/anonchat.db

# Админ-панель
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8080
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-please
# Любая длинная случайная строка (подпись cookie сессии)
SECRET_KEY=replace-with-long-random-string
# Публичный адрес панели (для кнопки в /admin внутри бота), необязательно
ADMIN_PUBLIC_URL=

# Каталог для кэша медиа, скачанных админкой
MEDIA_CACHE_DIR=data/media

# Ссылка на канал/чат поддержки (необязательно)
SUPPORT_USERNAME=
